# Environment files (Never commit credentials)
.env
.env.*
!.env.example

# Composer & Node dependencies
node_modules/

# Database dumps & local sqlite databases
*.sql
*.sqlite
*.sqlite3
*.db

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Laravel storage & cache
/storage/*.key
/storage/pail
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/public/storage
/public/build
/public/hot

# OS & Editor generated files
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed

# Auth / Credentials
auth.json
*.pem
*.key
*.cert
